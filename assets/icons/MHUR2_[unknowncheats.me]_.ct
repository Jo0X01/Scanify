              <CheatEntries>
                <CheatEntry>
                  <ID>113961268</ID>
                  <Description>"&lt;--- Infinite Abilities"</Description>
                  <Color>0080FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(INJECT,MHUR.exe,44 29 59 38 44 8B 8F D8 00 00 00) // should be unique
alloc(newmem,$1000,INJECT)

aobscanmodule(INJECT2,MHUR.exe,F3 0F 11 41 58 44) // should be unique
alloc(newmem2,$1000,INJECT2)

aobscanmodule(INJECT3,MHUR.exe,89 41 38 8B 87 D8 00 00 00) // should be unique
alloc(newmem3,$1000,INJECT3)


label(return)
label(return2)
label(return3)

newmem:
  mov [rcx+38],(int)200
  mov r9d,[rdi+000000D8]
  jmp return

newmem2:
  mov [rcx+58],(float)70
  jmp return2

newmem3:
  mov [rcx+38],(int)500
  mov eax,[rdi+000000D8]
  jmp return3

INJECT:
  jmp newmem
  nop 6
return:
registersymbol(INJECT)

INJECT2:
  jmp newmem2
return2:
registersymbol(INJECT2)

INJECT3:
  jmp newmem3
  nop 4
return3:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 44 29 59 38 44 8B 8F D8 00 00 00

INJECT2:
  db F3 0F 11 41 58

INJECT3:
  db 89 41 38 8B 87 D8 00 00 00

unregistersymbol(INJECT)
dealloc(newmem)

unregistersymbol(INJECT2)
dealloc(newmem2)

unregistersymbol(INJECT3)
dealloc(newmem3)

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>586026982</ID>
                  <Description>"&lt;--- Rental Tickets"</Description>
                  <Color>0080FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
