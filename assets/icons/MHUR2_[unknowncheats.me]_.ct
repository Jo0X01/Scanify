    <CheatEntry>
      <ID>113961269</ID>
      <Description>"ATTACH CHEAT TABLE TO MHUR.EXE"</Description>
      <Color>4848FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>0</ID>
          <Description>"&lt;--- CHECK BOX TO OPEN TABLE"</Description>
          <Options moHideChildren="1"/>
          <Color>4848FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

        aobscanmodule(INJECT,MHUR.exe,48 8B 01 FF 90 80 02 00 00 48 89 44) // should be unique
        alloc(newmem,$1000,INJECT)
        alloc(LocalPlayer,8)
        
        label(code)
        label(return)
        
        LocalPlayer:
        dq 00
        
        newmem:
        
        code:
          mov rax,[rcx]
          mov [LocalPlayer],rcx
          call qword ptr [rax+00000280]
          jmp return
        
        INJECT:
          jmp newmem
          nop 4
        return:
        registersymbol(INJECT LocalPlayer)
        
        [DISABLE]
        
        INJECT:
          db 48 8B 01 FF 90 80 02 00 00
        
        unregistersymbol(INJECT)
        unregistersymbol(LocalPlayer)
        dealloc(newmem)
        dealloc(LocalPlayer)
      
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>113961273</ID>
              <Description>"-----------------------------------------------------------------------------------"</Description>
              <Color>4848FF</Color>
